@page "/missions"
@inject IGamificationService Gamification
@inject IJSRuntime JS
@implements IDisposable

<!-- Level & Rank Overview Card -->
<div class="card-box" style="text-align: center; padding: 24px 20px; margin-bottom: 14px;">
    <div style="font-size: 52px; margin-bottom: 6px;">
        @(Gamification.Profile.Level >= 20 ? "🔥" : Gamification.Profile.Level >= 10 ? "👑" : Gamification.Profile.Level >= 5 ? "⚔️" : "🧭")
    </div>
    
    <div style="font-size: 11px; font-weight: 800; color: var(--mute); text-transform: uppercase; letter-spacing: 0.5px;">
        MEVCUT KADEME
    </div>
    <h2 style="font-size: 26px; font-weight: 900; color: var(--ink); margin: 2px 0 6px;">
        @UserProfile.GetRankTitle(Gamification.Profile.Level)
    </h2>
    
    <div style="display: inline-block; background: #eef2ff; color: #4338ca; font-size: 13px; font-weight: 800; padding: 4px 14px; border-radius: 20px; margin-bottom: 16px;">
        Seviye @Gamification.Profile.Level
    </div>

    <div style="margin-bottom: 6px; display: flex; justify-content: space-between; font-size: 11px; font-weight: 700; color: var(--mute);">
        <span>Bu Seviyedeki İlerlemen</span>
        <span>@Gamification.GetCurrentLevelXp() / @Gamification.GetXpRequiredForNextLevel() XP</span>
    </div>
    
    <div class="xp-bar-track" style="height: 10px; background: #e2e8f0; border-radius: 10px; margin-bottom: 8px;">
        <div class="xp-bar-fill" style="width: @(Gamification.GetLevelProgressPercentage().ToString("F0"))%; background: linear-gradient(90deg, #3b82f6, #10b981);"></div>
    </div>
    
    <div style="font-size: 11px; color: var(--mute); font-weight: 600;">
        Toplam Puanın: <b style="color: var(--ink);">@Gamification.Profile.Xp XP</b>
    </div>
</div>

<!-- Daily Missions Section -->
<div class="card-box" style="margin-bottom: 14px;">
    <div class="card-title-sm">
        <span>🎯 Günlük Görevler</span>
        <span style="color: #059669; font-weight: 800;">Her Gece Yenilenir</span>
    </div>

    @foreach (var m in _missions)
    {
        <div class="mission-row">
            <div class="mission-icon">@m.Icon</div>
            <div class="mission-info">
                <b>@m.Title</b>
                <span>@m.Description</span>
                <div class="mission-bar">
                    <div style="width: @(((double)m.Current / m.Target * 100).ToString("F0"))%;"></div>
                </div>
                <div style="font-size: 10px; color: var(--mute); margin-top: 3px; font-weight: 700;">
                    @m.Current / @m.Target • +@m.XpReward XP
                </div>
            </div>
            <div>
                @if (m.IsClaimed)
                {
                    <span style="font-size: 11px; font-weight: 800; color: #059669; background: #ecfdf5; padding: 6px 10px; border-radius: 10px;">
                        Alındı ✓
                    </span>
                }
                else if (m.IsCompleted)
                {
                    <button type="button" class="mission-claim-btn ready" @onclick="() => ClaimReward(m.Id)">
                        Ödülü Al 🎁
                    </button>
                }
                else
                {
                    <button type="button" class="mission-claim-btn" disabled>
                        Devam Ediyor
                    </button>
                }
            </div>
        </div>
    }
</div>

<!-- Achievement Badges Section -->
<div class="card-box">
    <div class="card-title-sm">
        <span>🏅 Başarı Rozetleri</span>
        <span>@_badges.Count(b => b.IsUnlocked) / @_badges.Count Açıldı</span>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
        @foreach (var badge in _badges)
        {
            <div style="border: 1px solid @(badge.IsUnlocked ? "var(--line-strong)" : "var(--line)"); background: @(badge.IsUnlocked ? "#ffffff" : "#f8fafc"); opacity: @(badge.IsUnlocked ? "1" : "0.55"); border-radius: 16px; padding: 12px; text-align: center; display: flex; flex-direction: column; align-items: center;">
                <div style="font-size: 32px; margin-bottom: 4px; filter: @(badge.IsUnlocked ? "none" : "grayscale(100%)");">
                    @badge.Icon
                </div>
                <b style="font-size: 13px; color: var(--ink); margin-bottom: 2px;">@badge.Title</b>
                <span style="font-size: 11px; color: var(--mute); line-height: 1.3;">@badge.Description</span>
                @if (badge.IsUnlocked)
                {
                    <span style="font-size: 10px; font-weight: 800; color: #059669; background: #ecfdf5; padding: 2px 8px; border-radius: 8px; margin-top: 6px;">
                        Kazanıldı 🌟
                    </span>
                }
                else
                {
                    <span style="font-size: 10px; font-weight: 700; color: var(--mute-light); margin-top: 6px;">
                        🔒 Kilitli
                    </span>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<DailyMission> _missions = new();
    private List<AchievementBadge> _badges = new();

    protected override void OnInitialized()
    {
        Gamification.OnStateChanged += RefreshData;
        RefreshData();
    }

    private void RefreshData()
    {
        _missions = Gamification.GetDailyMissions();
        _badges = Gamification.GetAllBadges();
        InvokeAsync(StateHasChanged);
    }

    private async Task ClaimReward(string missionId)
    {
        await Gamification.ClaimMissionRewardAsync(missionId);
        try
        {
            await JS.InvokeVoidAsync("appJs.showToast", "Ödül Alındı! XP Hesabına Eklendi 🎉");
        }
        catch { }
    }

    public void Dispose()
    {
        Gamification.OnStateChanged -= RefreshData;
    }
}
