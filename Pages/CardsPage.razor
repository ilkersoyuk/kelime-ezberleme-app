@page "/cards"
@inject IWordService WordService
@inject IGamificationService Gamification
@inject IJSRuntime JS
@implements IDisposable

<div class="card-box" style="padding: 14px; margin-bottom: 12px;">
    <!-- Filters Row -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 10px;">
        <div>
            <label style="font-size: 10px; font-weight: 800; color: var(--mute); text-transform: uppercase; margin-bottom: 4px; display: block;">KAYNAK LİSTESİ</label>
            <select @bind="_selectedList" @bind:after="OnFilterChanged" style="font-size: 12px; padding: 8px 10px;">
                <option value="zafer1124">Zafer Hoca (1124)</option>
                <option value="yds1000">YDS Sık Çıkanlar (1000)</option>
                <option value="all">Tüm Kelimeler (2124)</option>
            </select>
        </div>
        <div>
            <label style="font-size: 10px; font-weight: 800; color: var(--mute); text-transform: uppercase; margin-bottom: 4px; display: block;">ÜNİTE (50'şerli)</label>
            <select @bind="_selectedUnit" @bind:after="OnFilterChanged" style="font-size: 12px; padding: 8px 10px;">
                <option value="0">Tüm Üniteler</option>
                @foreach (var u in _availableUnits)
                {
                    <option value="@u">Ünite @u (@((u-1)*50 + 1) - @(u*50))</option>
                }
            </select>
        </div>
    </div>

    <!-- Sub tabs for study filter -->
    <div class="sub-tabs" style="margin-bottom: 0;">
        <button type="button" class="sub-tab @(_studyFilter == "all" ? "active" : "")" @onclick='() => SetStudyFilter("all")'>Tümü (@_totalInPool)</button>
        <button type="button" class="sub-tab @(_studyFilter == "unmastered" ? "active" : "")" @onclick='() => SetStudyFilter("unmastered")'>Öğrenilecekler (@_unmasteredCount)</button>
        <button type="button" class="sub-tab @(_studyFilter == "favorites" ? "active" : "")" @onclick='() => SetStudyFilter("favorites")'>⭐ Favoriler (@_favCount)</button>
    </div>
</div>

@if (_currentWords.Count == 0)
{
    <div class="card-box" style="text-align: center; padding: 36px 20px;">
        <div style="font-size: 40px; margin-bottom: 12px;">🎉</div>
        <h4 style="font-size: 16px; font-weight: 800; margin-bottom: 6px;">Bu Filtrede Kelime Yok</h4>
        <p style="font-size: 12px; color: var(--mute); margin-bottom: 16px;">Tüm kelimeleri tamamlamış olabilirsin ya da favori kelimen bulunmuyor.</p>
        <button type="button" class="btn-primary" style="max-width: 200px; margin: 0 auto;" @onclick='() => SetStudyFilter("all")'>Tüm Kelimeleri Göster</button>
    </div>
}
else if (_currentWord != null)
{
    <!-- Card Progress Bar Header -->
    <div style="padding: 0 16px; margin-bottom: 6px; display: flex; justify-content: space-between; align-items: center;">
        <span style="font-size: 12px; font-weight: 700; color: var(--mute);">
            Kart @(_currentIndex + 1) / @_currentWords.Count
        </span>
        <span style="font-size: 11px; font-weight: 800; color: var(--primary);">
            Ünite @_currentWord.Unit
        </span>
    </div>
    
    <div style="height: 5px; background: #e2e8f0; border-radius: 10px; margin: 0 14px 10px; overflow: hidden;">
        <div style="height: 100%; width: @(((double)(_currentIndex + 1) / _currentWords.Count * 100).ToString("F0"))%; background: var(--primary); border-radius: 10px; transition: width 0.25s ease;"></div>
    </div>

    <!-- 3D Flip Card Container -->
    <div class="card-box" style="padding: 0; background: transparent; border: none; box-shadow: none;">
        <div class="flashcard-stage">
            <div class="flashcard-inner @(_isFlipped ? "flipped" : "")" @onclick="ToggleFlip">
                
                <!-- FRONT FACE -->
                <div class="card-face card-face-front">
                    <div class="card-badge-row">
                        <span class="badge-tag">#@_currentWord.OriginalNumber • @_currentWord.ListName</span>
                        <div style="display: flex; gap: 8px; align-items: center;">
                            @if (_currentWord.Status == WordStatus.Mastered)
                            {
                                <span style="font-size: 10px; font-weight: 800; background: var(--emerald-subtle); color: var(--emerald); padding: 3px 8px; border-radius: 10px;">Ezberlendi</span>
                            }
                            else if (_currentWord.Status == WordStatus.Learning)
                            {
                                <span style="font-size: 10px; font-weight: 800; background: var(--primary-subtle); color: var(--primary); padding: 3px 8px; border-radius: 10px;">Öğreniliyor</span>
                            }
                            else if (_currentWord.Status == WordStatus.Review)
                            {
                                <span style="font-size: 10px; font-weight: 800; background: var(--rose-subtle); color: var(--rose); padding: 3px 8px; border-radius: 10px;">Tekrar</span>
                            }
                            <button type="button" @onclick:stopPropagation="true" @onclick="() => ToggleFavorite(_currentWord)" style="background: none; border: none; font-size: 20px; cursor: pointer;">
                                @(_currentWord.IsFavorite ? "⭐" : "☆")
                            </button>
                        </div>
                    </div>

                    <div style="margin: auto 0; padding: 20px 0;">
                        <h2 class="word-display-title">@_currentWord.Word</h2>
                        
                        @if (!string.IsNullOrWhiteSpace(_currentWord.Pronunciation))
                        {
                            <div class="word-display-pron">/@_currentWord.Pronunciation/</div>
                        }
                        
                        <div style="margin-top: 14px;">
                            <button type="button" class="audio-speak-btn" @onclick:stopPropagation="true" @onclick="() => WordService.SpeakAsync(_currentWord.Word)" title="Sesli Dinle">
                                🔊
                            </button>
                        </div>
                    </div>

                    <div style="font-size: 11px; font-weight: 700; color: var(--mute-light); letter-spacing: 0.3px;">
                        Anlamı görmek için dokun 👆
                    </div>
                </div>

                <!-- BACK FACE -->
                <div class="card-face card-face-back">
                    <div class="card-badge-row">
                        <span class="badge-tag">Türkçe Anlamı</span>
                        <button type="button" class="audio-speak-btn" style="width: 32px; height: 32px; font-size: 14px;" @onclick:stopPropagation="true" @onclick="() => WordService.SpeakAsync(_currentWord.Word)">
                            🔊
                        </button>
                    </div>

                    <div style="margin: auto 0; padding: 10px 0;">
                        <div style="font-size: 18px; font-weight: 800; color: var(--ink); margin-bottom: 8px;">@_currentWord.Word</div>
                        <div class="word-display-meaning">@_currentWord.Meaning</div>
                        
                        @if (!string.IsNullOrWhiteSpace(_currentWord.Details) && _currentWord.Details != _currentWord.Meaning)
                        {
                            <div class="word-display-detail">
                                @_currentWord.Details
                            </div>
                        }
                    </div>

                    <div style="font-size: 11px; font-weight: 700; color: var(--mute); margin-bottom: 6px;">
                        Durumunu seç ve ilerle 👇
                    </div>
                </div>

            </div>
        </div>

        <!-- Action Buttons (Hard / Learning / Mastered) -->
        <div class="card-actions-row">
            <button type="button" class="action-btn btn-hard" @onclick='() => MarkWord(WordStatus.Review)'>
                <span style="font-size: 16px;">🔄</span>
                <span>Zor / Tekrar</span>
                <small style="font-size: 9px; opacity: 0.8;">+4 XP</small>
            </button>
            <button type="button" class="action-btn btn-learning" @onclick='() => MarkWord(WordStatus.Learning)'>
                <span style="font-size: 16px;">📖</span>
                <span>Öğreniyorum</span>
                <small style="font-size: 9px; opacity: 0.8;">+8 XP</small>
            </button>
            <button type="button" class="action-btn btn-mastered" @onclick='() => MarkWord(WordStatus.Mastered)'>
                <span style="font-size: 16px;">✅</span>
                <span>Ezberledim</span>
                <small style="font-size: 9px; opacity: 0.8;">+15 XP</small>
            </button>
        </div>

        <!-- Next / Prev Controls -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 14px; padding: 0 4px;">
            <button type="button" class="btn-secondary" style="width: auto; padding: 8px 18px; font-size: 12px;" @onclick="PrevWord" disabled="@(_currentIndex <= 0)">
                ⬅️ Önceki
            </button>
            <span style="font-size: 11px; color: var(--mute); font-weight: 700;">
                @(_currentIndex + 1) / @_currentWords.Count
            </span>
            <button type="button" class="btn-secondary" style="width: auto; padding: 8px 18px; font-size: 12px;" @onclick="NextWord" disabled="@(_currentIndex >= _currentWords.Count - 1)">
                Sonraki ➡️
            </button>
        </div>
    </div>
}

@code {
    private string _selectedList = "zafer1124";
    private int _selectedUnit = 1;
    private string _studyFilter = "all";
    private List<int> _availableUnits = new();
    private List<WordItem> _currentWords = new();
    private WordItem? _currentWord;
    private int _currentIndex = 0;
    private bool _isFlipped = false;

    private int _totalInPool;
    private int _unmasteredCount;
    private int _favCount;

    protected override void OnInitialized()
    {
        WordService.OnWordsUpdated += OnWordsChanged;
        LoadPool();
    }

    private void LoadPool()
    {
        _availableUnits = WordService.GetAvailableUnits(_selectedList);
        if (_selectedUnit > 0 && !_availableUnits.Contains(_selectedUnit) && _availableUnits.Count > 0)
        {
            _selectedUnit = _availableUnits[0];
        }

        var basePool = WordService.FilterWords(
            listId: _selectedList == "all" ? null : _selectedList,
            unit: _selectedUnit > 0 ? _selectedUnit : null
        );

        _totalInPool = basePool.Count;
        _unmasteredCount = basePool.Count(w => w.Status != WordStatus.Mastered);
        _favCount = basePool.Count(w => w.IsFavorite);

        if (_studyFilter == "unmastered")
        {
            _currentWords = basePool.Where(w => w.Status != WordStatus.Mastered).ToList();
        }
        else if (_studyFilter == "favorites")
        {
            _currentWords = basePool.Where(w => w.IsFavorite).ToList();
        }
        else
        {
            _currentWords = basePool;
        }

        if (_currentIndex >= _currentWords.Count)
        {
            _currentIndex = 0;
        }

        _currentWord = _currentWords.Count > 0 ? _currentWords[_currentIndex] : null;
        _isFlipped = false;
    }

    private void OnFilterChanged()
    {
        _currentIndex = 0;
        LoadPool();
    }

    private void SetStudyFilter(string filter)
    {
        _studyFilter = filter;
        _currentIndex = 0;
        LoadPool();
    }

    private void ToggleFlip()
    {
        _isFlipped = !_isFlipped;
    }

    private async Task MarkWord(WordStatus status)
    {
        if (_currentWord == null) return;
        await WordService.UpdateWordStatusAsync(_currentWord, status);

        // Auto advance to next card
        if (_currentIndex < _currentWords.Count - 1)
        {
            _currentIndex++;
            _currentWord = _currentWords[_currentIndex];
            _isFlipped = false;
        }
        else
        {
            _isFlipped = false;
        }
    }

    private async Task ToggleFavorite(WordItem word)
    {
        await WordService.ToggleFavoriteAsync(word);
    }

    private void NextWord()
    {
        if (_currentIndex < _currentWords.Count - 1)
        {
            _currentIndex++;
            _currentWord = _currentWords[_currentIndex];
            _isFlipped = false;
        }
    }

    private void PrevWord()
    {
        if (_currentIndex > 0)
        {
            _currentIndex--;
            _currentWord = _currentWords[_currentIndex];
            _isFlipped = false;
        }
    }

    private void OnWordsChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        WordService.OnWordsUpdated -= OnWordsChanged;
    }
}
