@page "/backup"
@inject IStorageService StorageService
@inject IGamificationService Gamification
@inject IWordService WordService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<!-- Backup / Export / Import Card -->
<div class="card-box" style="margin-bottom: 14px;">
    <div class="card-title-sm">
        <span>💾 Veri Yedekleme & İçe Aktar</span>
        <span style="color: var(--primary); font-weight: 800;">Güvende Tut</span>
    </div>
    
    <p style="font-size: 12px; color: #64748b; line-height: 1.6; margin-bottom: 14px;">
        Telefonunu değiştirirsen, önbelleği temizlersen veya başka bir cihazda çalışmak istersen ilerlemeni kaybetmemek için yedeğini indirebilir, WhatsApp/Drive'a kaydedip dilediğin zaman geri yükleyebilirsin.
    </p>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px;">
        <button type="button" class="btn-primary" style="display: flex; align-items: center; justify-content: center; gap: 6px; padding: 12px;" @onclick="ExportData">
            <span>📤</span>
            <span>Yedeği İndir</span>
        </button>

        <label class="btn-secondary" style="display: flex; align-items: center; justify-content: center; gap: 6px; padding: 12px; text-align: center; cursor: pointer; margin: 0;">
            <span>⬆️</span>
            <span>Yedeği Yükle</span>
            <InputFile OnChange="ImportData" accept=".json" style="display: none;" />
        </label>
    </div>

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div style="font-size: 12px; font-weight: 700; color: #059669; background: #ecfdf5; padding: 8px 12px; border-radius: 10px; text-align: center; margin-top: 6px;">
            @_statusMessage
        </div>
    }
</div>

<!-- Mobile PWA Installation Guide Card -->
<div class="card-box" style="margin-bottom: 14px;">
    <div class="card-title-sm">
        <span>📱 Telefona Uygulama Olarak Ekle</span>
        <span>PWA</span>
    </div>
    
    <p style="font-size: 12px; color: #475569; line-height: 1.6; margin-bottom: 12px;">
        Bu web uygulamasını telefonunda tam ekran, reklamsız ve bildirim çubuğu olmadan gerçek bir uygulama gibi kullanabilirsin:
    </p>

    <div style="display: flex; flex-direction: column; gap: 10px; font-size: 12px;">
        <div style="background: #f8fafc; border: 1px solid var(--line); border-radius: 14px; padding: 12px;">
            <b style="color: var(--ink); display: block; margin-bottom: 4px;">🍏 iPhone / iPad (Safari)</b>
            <span>1. Safari ile bu sayfayı aç.<br />2. Alttaki <b>Paylaş (Kare ve yukarı ok)</b> simgesine tıkla.<br />3. Menüden <b>"Ana Ekrana Ekle"</b> seçeneğini seç.</span>
        </div>

        <div style="background: #f8fafc; border: 1px solid var(--line); border-radius: 14px; padding: 12px;">
            <b style="color: var(--ink); display: block; margin-bottom: 4px;">🤖 Android (Chrome)</b>
            <span>1. Chrome ile bu sayfayı aç.<br />2. Sağ üstteki <b>üç nokta (⋮)</b> menüsüne tıkla.<br />3. <b>"Uygulamayı Yükle"</b> veya <b>"Ana Ekrana Ekle"</b> seçeneğine bas.</span>
        </div>
    </div>
</div>

<!-- Detailed Stats Card -->
<div class="card-box" style="margin-bottom: 14px;">
    <div class="card-title-sm">
        <span>📈 Detaylı İstatistikler</span>
        <span>Kariyer</span>
    </div>

    <div style="display: flex; flex-direction: column; gap: 8px; font-size: 13px;">
        <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #f1f5f9; padding-bottom: 6px;">
            <span style="color: var(--mute);">Mevcut Seviye & Unvan:</span>
            <b style="color: var(--ink);">Lv. @Gamification.Profile.Level (@UserProfile.GetRankTitle(Gamification.Profile.Level))</b>
        </div>
        <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #f1f5f9; padding-bottom: 6px;">
            <span style="color: var(--mute);">Toplam XP Puanı:</span>
            <b style="color: #2563eb;">@Gamification.Profile.Xp XP</b>
        </div>
        <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #f1f5f9; padding-bottom: 6px;">
            <span style="color: var(--mute);">Günlük Çalışma Serisi:</span>
            <b style="color: #d97706;">🔥 @Gamification.Profile.StreakDays Gün</b>
        </div>
        <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #f1f5f9; padding-bottom: 6px;">
            <span style="color: var(--mute);">Toplam Kart İncelemesi:</span>
            <b style="color: var(--ink);">@Gamification.Profile.TotalReviews Adet</b>
        </div>
        <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #f1f5f9; padding-bottom: 6px;">
            <span style="color: var(--mute);">Toplam Çözülen Quiz Sorusu:</span>
            <b style="color: var(--ink);">@Gamification.Profile.TotalQuizzesSolved Soru</b>
        </div>
        <div style="display: flex; justify-content: space-between; padding-bottom: 4px;">
            <span style="color: var(--mute);">Toplam Doğru Cevap:</span>
            <b style="color: #059669;">@Gamification.Profile.TotalCorrectAnswers (@(Gamification.Profile.TotalQuizzesSolved > 0 ? (int)((double)Gamification.Profile.TotalCorrectAnswers / Gamification.Profile.TotalQuizzesSolved * 100) : 0)%)</b>
        </div>
    </div>
</div>

<!-- Danger Zone / Reset -->
<div class="card-box" style="border-color: #fecdd3; background: #fff5f5;">
    <div class="card-title-sm" style="color: #e11d48;">
        <span>⚠️ Sıfırlama Bölgesi</span>
    </div>
    <p style="font-size: 11px; color: #9f1239; margin-bottom: 10px;">
        Tüm ilerlemeni, XP puanlarını ve seviyeni sıfırlamak istiyorsan aşağıdaki butona basabilirsin. Bu işlem geri alınamaz (öncesinde yedek almayı unutma).
    </p>
    <button type="button" class="btn-secondary" style="color: #e11d48; border-color: #fca5a5; background: #fff;" @onclick="ResetData">
        Tüm Verileri Sıfırla 🗑️
    </button>
</div>

@code {
    private string _statusMessage = "";

    private async Task ExportData()
    {
        await StorageService.ExportBackupAsync(Gamification.Profile);
        _statusMessage = "Yedek dosyası cihazına indirildi! ✅";
    }

    private async Task ImportData(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            using var stream = file.OpenReadStream(maxAllowedSize: 10_000_000);
            using var reader = new System.IO.StreamReader(stream);
            var content = await reader.ReadToEndAsync();

            var restored = await StorageService.ImportBackupAsync(content);
            if (restored != null)
            {
                await Gamification.InitializeAsync();
                await WordService.InitializeAsync();
                _statusMessage = "Yedek başarıyla yüklendi ve uygulandı! 🎉";
                await JS.InvokeVoidAsync("appJs.showToast", "Yedek başarıyla yüklendi!");
            }
            else
            {
                _statusMessage = "Geçersiz yedek dosyası formatı!";
            }
        }
        catch (Exception ex)
        {
            _statusMessage = "Yükleme hatası: " + ex.Message;
        }
    }

    private async Task ResetData()
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Tüm kelime ezber ilerlemen ve seviyen sıfırlanacak. Onaylıyor musun?");
        if (confirmed)
        {
            await StorageService.ResetDataAsync();
            await Gamification.InitializeAsync();
            await WordService.InitializeAsync();
            _statusMessage = "Veriler sıfırlandı.";
            await JS.InvokeVoidAsync("appJs.showToast", "Tüm ilerleme sıfırlandı.");
            Navigation.NavigateTo("/");
        }
    }
}
